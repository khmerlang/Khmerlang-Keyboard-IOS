      }
    },
    "What we do not collect" : {
      "localizations" : {
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្វីដែលយើងមិនប្រមូល"
          }
        }
      }
    },
    "When enabled, typed text before the cursor is sent to Khmerlang servers to return spelling suggestions. This requires Full Access for the keyboard extension." : {
      "localizations" : {
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "នៅពេលបើក អត្ថបទដែលវាយនៅមុខទស្សន៍ទ្រនិចនឹងត្រូវផ្ញើទៅម៉ាស៊ីនមេ Khmerlang ដើម្បីទទួលការណែនាំអក្ខរាវិរុទ្ធ។ មុខងារនេះត្រូវការ Full Access សម្រាប់ក្ដារចុច។"
          }
        }
      }
    },
    "Without Full Access, cloud spell check cannot run and the keyboard continues with local features." : {
      "localizations" : {
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បើគ្មាន Full Access ការពិនិត្យអក្ខរាវិរុទ្ធតាមអ៊ីនធឺណិតមិនអាចដំណើរការបានទេ ប៉ុន្តែក្ដារចុចនៅតែដំណើរការជាមួយមុខងារក្នុងឧបករណ៍។"
          }
        }
      }
    },
    "You can disable cloud spell check at any time in this app." : {
      "localizations" : {
