      "localizations" : {
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "យើងអនុវត្តវិធានការសមស្របដើម្បីការពារទិន្នន័យ ទាំងពេលបញ្ជូន និងពេលរក្សាទុក។"
          }
        }
      }
    },
    "We do not require account sign-in to use the keyboard." : {
      "localizations" : {
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "យើងមិនតម្រូវឱ្យចុះឈ្មោះគណនីដើម្បីប្រើក្ដារចុចទេ។"
          }
        }
      }
    },
    "We retain only the minimum operational data needed to run and improve the service." : {
      "localizations" : {
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "យើងរក្សាទុកតែទិន្នន័យប្រតិបត្តិការអប្បបរមាដែលចាំបាច់សម្រាប់ដំណើរការ និងកែលម្អសេវាកម្មប៉ុណ្ណោះ។"
          }
        }
      }
    },
    "What we collect" : {
      "localizations" : {
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្វីដែលយើងប្រមូល"
